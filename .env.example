# A service account from your Keycard org: Console → Settings → Service accounts.
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=

# Acme's agents run on Claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Leave unset to use a Cloudflare quick tunnel (needs `brew install cloudflared`).
# Set it to a stable https address that reaches localhost:4747 (named Cloudflare tunnel, ngrok, tailscale funnel).
# PUBLIC_URL=

# Optional. Log each request Acme Work receives through the gateways, with the status it answered.
# DEBUG=1

# Optional. Defaults shown. The two agents listen on PORT+1 and PORT+2, on localhost only.
# PORT=4747
